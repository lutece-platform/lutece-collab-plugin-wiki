<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
       xmlns:p="http://www.springframework.org/schema/p">

    <!-- DAO -->
    <bean id="wiki.wikiItemDAO" class="fr.paris.lutece.plugins.wiki.business.item.WikiItemDAO" />
    <bean id="wiki.revisionDAO" class="fr.paris.lutece.plugins.wiki.business.revision.RevisionDAO" />
    <bean id="wiki.suggestedRevisionDAO" class="fr.paris.lutece.plugins.wiki.business.suggestedrevision.SuggestedRevisionDAO" />
    <bean id="wiki.wikiItemUserPermissionDAO" class="fr.paris.lutece.plugins.wiki.business.permission.WikiItemUserPermissionDAO" />
    <bean id="wiki.wikiItemAttributePermissionDAO" class="fr.paris.lutece.plugins.wiki.business.permission.WikiItemAttributePermissionDAO" />

    <!-- Cache Service -->
    <bean id="wiki.cacheService" class="fr.paris.lutece.plugins.wiki.service.cache.WikiCacheService"
          factory-method="getInstance" />

    <!-- Search Event Listener -->
    <bean id="wiki.searchEventListener" class="fr.paris.lutece.plugins.wiki.service.search.WikiSearchEventListener"
          factory-method="getInstance" />

    <!-- Asynchronous Upload Handler -->
    <bean id="wiki.asynchronousUploadHandler" class="fr.paris.lutece.plugins.wiki.service.file.WikiAsynchronousUploadHandler" />

    <!-- Wiki File RBAC Service -->
    <bean id="wiki.wikiFileRBACService" class="fr.paris.lutece.plugins.wiki.service.file.WikiFileRBACService" />

    <!-- Wiki File Store Service Provider -->
    <bean id="wikiFileStoreProvider" class="fr.paris.lutece.portal.service.file.implementation.LocalDatabaseFileService">
        <constructor-arg ref="defaultFileDownloadUrlService" />
        <constructor-arg ref="wiki.wikiFileRBACService" />
        <property name="default" value="false" />
        <property name="name" value="wikiFileStoreProvider" />
    </bean>

    <!-- REST Services -->
    <bean id="wiki.wikiCodeValidationRest" class="fr.paris.lutece.plugins.wiki.rs.WikiCodeValidationRest" />
    <bean id="wiki.wikiItemRest" class="fr.paris.lutece.plugins.wiki.rs.WikiItemRest" />
    <bean id="wiki.wikiSuggestionRest" class="fr.paris.lutece.plugins.wiki.rs.WikiSuggestionRest" />
    <bean id="wiki.wikiUserPermissionRest" class="fr.paris.lutece.plugins.wiki.rs.WikiUserPermissionRest" />

</beans>