<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<plug-in>
    <name>wiki</name>
    <class>fr.paris.lutece.plugins.wiki.service.WikiPlugin</class>
    <version>6.0.0-SNAPSHOT</version>
    <documentation/>
    <installation/>
    <changes/>
    <user-guide/>
    <description>wiki.plugin.description</description>
    <provider>wiki.plugin.provider</provider>
    <provider-url>http://www.paris.fr</provider-url>
    <icon-url>images/admin/skin/feature_default_icon.png</icon-url>
    <copyright>Copyright (c) 2002-2025 City of Paris</copyright>

    <!-- DB pool -->
    <db-pool-required>1</db-pool-required>

    <core-version-dependency>
        <min-core-version>8.0.0</min-core-version>
        <max-core-version/>
    </core-version-dependency>

    <!-- XPages -->
    <applications>
        <application>
            <application-id>wiki</application-id>
        </application>
        <application>
            <application-id>wikiitemmanagement</application-id>
        </application>
        <application>
            <application-id>wikisuggestion</application-id>
        </application>
    </applications>

    <!-- Search Indexer Service -->
    <search-indexers>
        <search-indexer>
            <search-indexer-class>
                fr.paris.lutece.plugins.wiki.service.search.WikiSearchIndexer
            </search-indexer-class>
        </search-indexer>
    </search-indexers>

    <!-- Search Engine -->
    <search-engines>
        <search-engine>
            <search-engine-class>
                fr.paris.lutece.plugins.wiki.service.search.WikiSearchEngine
            </search-engine-class>
        </search-engine>
    </search-engines>

    <!-- RBAC Resources -->
    <rbac-resource-types>
        <rbac-resource-type>
            <rbac-resource-type-class>
                fr.paris.lutece.plugins.wiki.service.rbac.WikiSpaceResourceIdService
            </rbac-resource-type-class>
        </rbac-resource-type>
        <rbac-resource-type>
            <rbac-resource-type-class>
                fr.paris.lutece.plugins.wiki.service.rbac.WikiCategoryResourceIdService
            </rbac-resource-type-class>
        </rbac-resource-type>
        <rbac-resource-type>
            <rbac-resource-type-class>
                fr.paris.lutece.plugins.wiki.service.rbac.WikiBookResourceIdService
            </rbac-resource-type-class>
        </rbac-resource-type>
        <rbac-resource-type>
            <rbac-resource-type-class>
                fr.paris.lutece.plugins.wiki.service.rbac.WikiChapterResourceIdService
            </rbac-resource-type-class>
        </rbac-resource-type>
        <rbac-resource-type>
            <rbac-resource-type-class>
                fr.paris.lutece.plugins.wiki.service.rbac.WikiPageResourceIdService
            </rbac-resource-type-class>
        </rbac-resource-type>
    </rbac-resource-types>
</plug-in>
